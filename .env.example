# Copy to .env.local and fill real values. Never commit .env.local.
ANTHROPIC_API_KEY=<your-anthropic-key>
NOTION_API_KEY=<your-notion-token>
NOTION_DATA_SOURCE_AESTHETICS=<aesthetics-db-id-32-chars>
NOTION_DATA_SOURCE_LAYOUTS=<layouts-db-id-32-chars>
NOTION_DATA_SOURCE_INTERACTIONS=<interactions-db-id-32-chars>
NOTION_DATA_SOURCE_SYSTEMS=<systems-db-id-32-chars>
OPENROUTER_API_KEY=<openrouter-api-key-starts-with-sk-or->
ADMIN_SECRET=<random-admin-string-16-plus-chars>
DAILY_COST_ALERT_USD=50

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...                       # the anon public token
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...               # the service_role secret token
FB_ARCHIVE_BACKEND=fs                              # keep `fs` for dev; subagent flips to supabase for prod
NEXT_PUBLIC_APP_URL=http://localhost:3000          # local dev URL
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co # mirror of SUPABASE_URL (for client bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...           # mirror of SUPABASE_ANON_KEY
